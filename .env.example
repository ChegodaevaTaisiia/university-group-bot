# ── Telegram ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:AA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user id (узнать: напиши @userinfobot). Несколько — через запятую.
ADMIN_IDS=111111111

# id супергруппы с топиками (обычно начинается с -100...).
# Узнать: временно включи в боте логирование апдейтов или напиши /chatid в группе.
SUPERGROUP_ID=-1001234567890

# Часовой пояс группы
TIMEZONE=Europe/Moscow

# Дата понедельника «нечётной» (1-й) недели семестра — от неё считается числитель/знаменатель
SEMESTER_START=2026-09-01

# Имя, на которое бот откликается в чате: «Плеша, что задали?». Можно несколько через запятую.
BOT_NICKNAME=Плеша, Плеш
# Во сколько (час) бот поздравляет группу с ДР и праздниками
GREETINGS_HOUR=9

# ── Хранилище ────────────────────────────────────────────────────────────
DATA_DIR=./data

# ── ИИ (Claude) — можно оставить пустым, бот заработает без ИИ ────────────
# Ключ с console.anthropic.com (см. README → «Как получить ключ Anthropic API»)
ANTHROPIC_API_KEY=
# Только если ключ от прокси-сервиса (не sk-ant-...): их адрес, например https://api.proxy.tld
ANTHROPIC_BASE_URL=
AI_MODEL=claude-haiku-4-5
# Месячный потолок расходов на ИИ в долларах. При превышении ИИ-ответы отключаются.
AI_MONTHLY_BUDGET_USD=5
# Сколько ИИ-запросов в час разрешено одному студенту
AI_USER_HOURLY_LIMIT=15

# Страница твоей высшей школы / факультета на сайте вуза — для автосбора преподавателей.
# По умолчанию: ВШ кибертехнологий, математики и статистики РЭУ. Пусто = парсер выключен.
KB_SCHOOL_URL=https://www.rea.ru/structure/hs/vyisshaya-shkola-kibertehnologiy-matematiki-i-statistiki

# Расписание группы с rasp.rea.ru — скопируй адрес со страницы своей группы.
# Пусто = автозагрузка расписания выключена (можно вводить вручную текстом).
RASP_URL=
RASP_CHECK_HOURS=3

# Если на сервере не работает IPv4 (или IPv6) до api.telegram.org — форсируй:
# TELEGRAM_IP_FAMILY=v6   (или v4). Пусто = как решит система.
TELEGRAM_IP_FAMILY=
